{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePresets": [
    "replacements:all"
  ],
  "timezone": "Europe/London",
  "schedule": [
    "* 0-5 1 * *"
  ],
  "updateNotScheduled": false,
  "automerge": false,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "automerge": false
  },
  "major": {
    "dependencyDashboardApproval": true
  },
  "packageRules": [
    {
      "description": "All npm (app/, tools/): one monthly PR; majors split off and wait for Dashboard approval",
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm dependencies"
    },
    {
      "description": "All Actions incl. setup-node node-version: one monthly PR; majors wait for approval",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "0.x minors are breaking (babel-plugin-polyfill-corejs3 drives the Chromium 53 polyfills): own branch, approval only",
      "matchManagers": [
        "npm"
      ],
      "matchCurrentVersion": "<1.0.0",
      "matchUpdateTypes": [
        "minor"
      ],
      "groupName": "npm 0.x minor",
      "dependencyDashboardApproval": true
    },
    {
      "description": "Vite 8 drops its esbuild dependency (app/vite.config.ts imports esbuild) and lowers syntax via Rolldown/Oxc; chrome53 unverified",
      "matchPackageNames": [
        "vite"
      ],
      "allowedVersions": "<8"
    },
    {
      "description": "@preact/preset-vite 2.x peers @babel/core 7.x",
      "matchPackageNames": [
        "@babel/core"
      ],
      "allowedVersions": "<8"
    }
  ]
}
