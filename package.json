{
  "name": "lumen-webos",
  "private": true,
  "description": "Lumen, a launcher for rooted LG webOS TVs. The app is in app/, the tools in tools/.",
  "scripts": {
    "build:ipk": "sh tools/build_ipk.sh",
    "deploy": "sh tools/deploy.sh",
    "deploy:home": "LUMEN_APP_ID=com.ovsteenb.lumen LUMEN_APP_TITLE=Lumen LUMEN_DEV=1 sh tools/deploy.sh",
    "push-font": "sh tools/push_sf_font.sh",
    "dev": "npm --prefix app run dev",
    "release": "python3 tools/build_release.py",
    "test": "node --test tools/test/*.test.mjs"
  }
}
